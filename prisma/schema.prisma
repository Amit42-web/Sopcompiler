// RuleForge AI — persistent data model (PostgreSQL).
//
// The model is normalized and portable: enum-like fields are stored as
// validated strings and list/JSON fields as JSON strings, so it runs on any
// SQL database. PostgreSQL is used for deployment (Vercel, etc.); for local
// development, `docker compose up -d` starts a matching Postgres.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" covers local dev; the rhel target covers Vercel's runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("viewer") // owner | admin | editor | viewer
  status    String   @default("active") // active | invited
  invitedAt DateTime?
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  department  String?
  status      String   @default("draft") // draft | processing | ready | error
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files      SopFile[]
  ruleSets   RuleSet[]
  activities Activity[]
  runs       ProcessingRun[]

  @@index([createdAt])
}

model SopFile {
  id          String   @id @default(cuid())
  projectId   String
  filename    String
  contentType String
  sizeBytes   Int
  status      String   @default("uploaded")
  version     Int      @default(1)
  pageCount   Int?
  charCount   Int?
  contentHash String   @default("")
  rawText     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metadata      Metadata?
  sections      Section[]
  scenarios     Scenario[]
  knowledgeBase KnowledgeEntry[]
  runs          ProcessingRun[]
  activities    Activity[]

  @@index([projectId])
  @@index([createdAt])
  @@index([contentHash])
}

model Metadata {
  id            String  @id @default(cuid())
  fileId        String  @unique
  title         String?
  department    String?
  version       String?
  effectiveDate String?
  owner         String?
  tags          String  @default("[]") // JSON array of strings

  file SopFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Section {
  id     String @id @default(cuid())
  fileId String
  title  String
  level  Int    @default(1)
  text   String
  order  Int    @default(0)

  file SopFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Scenario {
  id              String @id @default(cuid())
  fileId          String
  sectionRef      String?
  condition       String
  resolution      String
  resolutionGroup String @default("Other")
  confidence      Float  @default(0.5)

  file SopFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model KnowledgeEntry {
  id          String @id @default(cuid())
  fileId      String
  term        String
  definition  String
  occurrences Int    @default(1)

  file SopFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model RuleSet {
  id                 String   @id @default(cuid())
  projectId          String
  name               String   @default("Generated rule set")
  version            String   @default("1.0.0")
  metadataConditions String   @default("[]") // JSON MetadataCondition[]
  createdAt          DateTime @default(now())

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rules             Rule[]
  validationReports ValidationReport[]

  @@index([projectId])
}

model Rule {
  id             String  @id @default(cuid())
  ruleSetId      String
  name           String
  description    String  @default("")
  priority       Int     @default(50)
  enabled        Boolean @default(true)
  conditions     String  @default("[]") // JSON RuleCondition[] (flattened leaves)
  actions        String  @default("[]") // JSON RuleAction[]
  sourceScenario String?

  // Structured extraction fields
  category         String  @default("business_rule") // business_rule | agent_obligation | backend_action | metadata_condition
  actionKind       String  @default("business_rule") // agent_action | backend_action | business_rule
  obligation       String  @default("mandatory") // mandatory | conditional
  branch           String  @default("main") // main | exception | alternate
  orderIndex       Int     @default(0)
  validationPrompt String?
  preconditions    String  @default("[]") // JSON string[]
  conditionsTree   String  @default("null") // JSON ConditionNode | null
  appliesTo        String  @default("[]") // JSON RuleBinding[]
  reusableKey      String  @default("")
  rawText          String  @default("")

  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId])
}

model ValidationReport {
  id           String   @id @default(cuid())
  ruleSetId    String
  valid        Boolean
  checkedRules Int
  issues       String   @default("[]") // JSON ValidationIssue[]
  createdAt    DateTime @default(now())

  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId])
}

model ProcessingRun {
  id         String   @id @default(cuid())
  projectId  String
  fileId     String
  success    Boolean
  durationMs Int      @default(0)
  scenarios  Int      @default(0)
  rules      Int      @default(0)
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    SopFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fileId])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  projectId String?
  fileId    String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    SopFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([projectId])
}
