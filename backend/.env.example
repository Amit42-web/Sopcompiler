# RuleForge AI backend configuration

# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Directory where uploaded SOP documents are stored.
UPLOAD_DIR=./uploads

# --- Optional LLM enhancer -------------------------------------------------
# The AI pipeline runs on built-in heuristics by default. If you set an
# Anthropic API key, the pipeline uses the model to improve section and
# scenario extraction. Leave blank to stay fully offline.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
