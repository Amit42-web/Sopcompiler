# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env holds only the non-secret SQLite default and is committed so the app
# runs out of the box. Put secrets (SMTP_*, ANTHROPIC_API_KEY, a Postgres URL)
# in .env.local, which is ignored.
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated on install/build)
/src/generated

# sqlite database files (created locally on first run)
/prisma/*.db
/prisma/*.db-journal

# local postgres data (dev only)
/.pgdata
/.pgrun
