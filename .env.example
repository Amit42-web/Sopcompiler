# RuleForge AI configuration
#
# `.env` (committed) holds the non-secret local Postgres default. Copy this
# file to `.env.local` (git-ignored) to override it or add secrets.

# --- Database (PostgreSQL) -------------------------------------------------
# Local default (committed in .env, matches docker-compose.yml):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruleforge?schema=public"
# In production (Vercel etc.), set DATABASE_URL in the platform's env vars; it
# overrides .env. Serverless deployments require Postgres — not SQLite.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# --- Invitation email (optional) -------------------------------------------
# When set, team invitations are emailed to the invitee. Use either a single
# SMTP_URL or the discrete fields. Without these, invites are still recorded
# but no email is sent.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RuleForge AI <no-reply@yourdomain.com>"

# --- Optional LLM enhancer -------------------------------------------------
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
