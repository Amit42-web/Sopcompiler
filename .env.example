# RuleForge AI configuration
#
# The app ships with a zero-config SQLite default in `.env` — it runs and
# persists with no setup. Copy this file to `.env.local` only to override
# defaults or add secrets. `.env.local` is git-ignored.

# --- Database --------------------------------------------------------------
# Default (committed in .env): a local SQLite file — no server required.
#   DATABASE_URL="file:./dev.db"
# For production/scale, use PostgreSQL instead: set the URL here AND change the
# datasource `provider` in prisma/schema.prisma to "postgresql".
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ruleforge?schema=public"

# --- Invitation email (optional) -------------------------------------------
# When set, team invitations are emailed to the invitee. Use either a single
# SMTP_URL or the discrete fields. Without these, invites are still recorded
# but no email is sent.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RuleForge AI <no-reply@yourdomain.com>"

# --- Optional LLM enhancer -------------------------------------------------
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
