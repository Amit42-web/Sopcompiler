# RuleForge AI configuration

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string. Prisma reads this at runtime.
# Local dev example (matches `npm run db:*`):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ruleforge?schema=public"

# --- API base URL ----------------------------------------------------------
# Leave blank to use this app's own Route Handlers (same-origin).
NEXT_PUBLIC_API_URL=

# --- Optional LLM enhancer -------------------------------------------------
# The AI pipeline runs on built-in heuristics by default. Set an Anthropic API
# key to enable scenario refinement. Leave blank to stay fully offline.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
