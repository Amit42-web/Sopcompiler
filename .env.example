# RuleForge AI configuration (single Next.js app)

# Base URL of the API. Leave blank to use this app's own Route Handlers
# (same-origin). Set it only to point the frontend at a remote deployment.
NEXT_PUBLIC_API_URL=

# --- Optional LLM enhancer -------------------------------------------------
# The AI pipeline runs on built-in heuristics by default. If you set an
# Anthropic API key, the pipeline uses the model to refine scenario
# extraction. Leave blank to stay fully offline.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
