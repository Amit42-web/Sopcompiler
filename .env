# Committed defaults (non-secret). Put secrets in .env.local (git-ignored).
#
# Local development database — matches docker-compose.yml. Run:
#   docker compose up -d      (starts Postgres on localhost:5432)
# In production (e.g. Vercel), set DATABASE_URL in the platform's environment
# variables; that value overrides this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruleforge?schema=public"
